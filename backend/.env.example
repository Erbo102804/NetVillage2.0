# Django
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database (PostgreSQL)
DB_NAME=netvillage
DB_USER=netvillage
DB_PASSWORD=netvillage_pass
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MikroTik Router
MIKROTIK_HOST=10.1.100.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your-mikrotik-password
MIKROTIK_PORT=8728

# Kaspi Pay (получить на kaspi.kz/biznes)
KASPI_MERCHANT_ID=your-merchant-id
KASPI_API_KEY=your-api-key
KASPI_API_URL=https://kaspi.kz/online
